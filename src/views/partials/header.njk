<header class="nav" role="banner" data-nav>
  <div class="nav-in">
    <a class="nav-logo" href="/" aria-label="{{ S.site_name }} — الرئيسية"><img src="{{ S.logo_compact or '/img/logo-compact-white.svg' }}" alt="{{ S.brand_short }}" width="160" height="45"></a>
    <nav class="nav-main" aria-label="القائمة الرئيسية">
      <ul class="nav-links">
        {% for item in S.nav_items %}
        {% if item.dropdown == 'services' and navCats.length %}
        <li class="has-dd">
          <a href="{{ item.url }}" aria-haspopup="true" {% if currentPath.indexOf(item.url) == 0 and item.url != '/' %}aria-current="page"{% endif %}>{{ item.label }}{{ icon('chevron-down', 'chev') }}</a>
          <div class="dropdown">
            <div class="dd-grid">
              {% for c in navCats %}
              <a class="dd-item" href="{{ c.url }}">
                <span class="dd-ic">{{ icon(c.icon or 'scale') }}</span>
                <span class="dd-body"><b>{{ c.title }}</b><span class="dd-tx">{{ c.tagline or (c.summary | truncate_ar(70)) }}</span></span>
                {{ icon('arrow-left', 'dd-go') }}
              </a>
              {% endfor %}
            </div>
            {% if S.mega_note or S.mega_cta_label %}
            <div class="dd-foot">
              {% if S.mega_note %}<span>{{ S.mega_note }}</span>{% endif %}
              {% if S.mega_cta_label %}<a class="link-arrow" href="{{ S.mega_cta_url or '/consultation' }}">{{ S.mega_cta_label }} {{ icon('arrow-left') }}</a>{% endif %}
            </div>
            {% endif %}
          </div>
        </li>
        {% else %}
        <li><a href="{{ item.url }}" {% if (item.url == '/' and currentPath == '/') or (item.url != '/' and currentPath.indexOf(item.url) == 0) %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}
        {% endfor %}
      </ul>
    </nav>
    <div class="nav-actions">
      <a class="nav-search-btn" href="/search" data-search-open aria-controls="nav-search" aria-expanded="false" aria-label="البحث في الموقع">{{ icon('search') }}</a>
      <button class="theme-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="الوضع الليلي" data-tip="الوضع الليلي">{{ icon('moon', 'th-moon') }}{{ icon('sun', 'th-sun') }}</button>
      <a class="nav-call" href="{{ S.phone | tel }}" aria-label="{{ S.txt_call_now }} {{ S.phone }}">{{ icon('phone') }}</a>
      {% if S.nav_cta_label %}<a class="btn btn-white nav-cta" href="{{ S.nav_cta_url }}">{{ S.nav_cta_label }} {{ icon('arrow-left') }}</a>{% endif %}
      <button class="nav-toggle" type="button" data-menu-open aria-controls="mnav" aria-expanded="false" aria-label="فتح القائمة">{{ icon('menu') }}</button>
    </div>
  </div>
  <form class="nav-search" id="nav-search" action="/search" method="get" role="search" hidden>
    {{ icon('search') }}
    <input type="search" name="q" placeholder="ابحث عن خدمة، قضية، أو سؤال…" aria-label="كلمات البحث" minlength="2" maxlength="80" required>
    <button class="btn btn-teal btn-sm" type="submit">بحث</button>
    <button class="nav-search-x" type="button" data-search-close aria-label="إغلاق البحث">{{ icon('x') }}</button>
  </form>
</header>

<div class="mnav" id="mnav" aria-hidden="true" role="dialog" aria-modal="true" aria-label="القائمة">
  <div class="mnav-backdrop" data-menu-close></div>
  <div class="mnav-panel">
    <div class="mnav-top">
      <a href="/" aria-label="{{ S.site_name }} — الرئيسية"><img class="logo-light" src="{{ S.logo or '/img/logo.svg' }}" alt="{{ S.brand_short }}" width="150" height="60"><img class="logo-dark" src="{{ S.logo_white or '/img/logo-white.svg' }}" alt="{{ S.brand_short }}" width="150" height="60" loading="lazy"></a>
      <button class="theme-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="الوضع الليلي" data-tip="الوضع الليلي">{{ icon('moon', 'th-moon') }}{{ icon('sun', 'th-sun') }}</button>
      <button class="mnav-close" type="button" data-menu-close aria-label="إغلاق القائمة">{{ icon('x') }}</button>
    </div>
    <form class="mnav-search" action="/search" method="get" role="search">
      {{ icon('search') }}<input type="search" name="q" placeholder="ابحث في الموقع…" aria-label="البحث في الموقع" minlength="2" maxlength="80" required>
    </form>
    <ul class="mnav-list">
      {% for item in S.nav_items %}
      <li style="--k:{{ loop.index0 }}"><a href="{{ item.url }}" {% if (item.url == '/' and currentPath == '/') or (item.url != '/' and currentPath.indexOf(item.url) == 0) %}aria-current="page"{% endif %}>{{ item.label }} {{ icon('arrow-left') }}</a>
        {% if item.dropdown == 'services' and navCats.length %}
        <ul class="mnav-sub">
          {% for c in navCats %}<li><a href="{{ c.url }}"><span class="dd-ic">{{ icon(c.icon or 'scale') }}</span><span>{{ c.title }}</span></a></li>{% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    <div class="mnav-cta">
      {% if S.nav_cta_label %}<a class="btn btn-teal btn-lg" href="{{ S.nav_cta_url }}">{{ S.nav_cta_label }} {{ icon('arrow-left') }}</a>{% endif %}
      <a class="btn btn-line btn-lg" href="{{ S.phone | tel }}">{{ icon('phone') }} <span dir="ltr">{{ S.phone }}</span></a>
    </div>
  </div>
</div>
