<!doctype html>
<html lang="ar" dir="rtl" class="no-js">
<head>
<meta charset="utf-8">
{# الوضع النهاري هو الافتراضي؛ الليلي فقط إذا اختاره الزائر بنفسه (يُضبط قبل أول رسم) — التفاصيل في theme.js #}
<script>(function(d){var t;try{t=localStorage.getItem('isgha_theme')}catch(e){}d.setAttribute('data-theme',t==='dark'?'dark':'light')})(document.documentElement)</script>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<script>(function(d){d.className=d.className.replace('no-js','js');setTimeout(function(){if(!window.ISGHA_READY)d.classList.add('no-js')},3500)})(document.documentElement)</script>
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
<meta name="robots" content="{{ meta.robots }}">
<link rel="canonical" href="{{ meta.canonical }}">
<meta property="og:locale" content="ar_SA">
<meta property="og:type" content="{{ meta.type }}">
<meta property="og:site_name" content="{{ S.site_name }}">
<meta property="og:title" content="{{ meta.ogTitle or meta.title }}">
<meta property="og:description" content="{{ meta.description }}">
<meta property="og:url" content="{{ meta.canonical }}">
<meta property="og:image" content="{{ meta.image }}">
{% if meta.imageWidth %}<meta property="og:image:width" content="{{ meta.imageWidth }}">
<meta property="og:image:height" content="{{ meta.imageHeight }}">
{% endif %}
{% if meta.imageAlt %}<meta property="og:image:alt" content="{{ meta.imageAlt }}">
{% endif %}
{% if meta.type == 'article' %}{% if meta.published %}<meta property="article:published_time" content="{{ meta.published }}">
{% endif %}{% if meta.modified %}<meta property="article:modified_time" content="{{ meta.modified }}">
{% endif %}{% if meta.section %}<meta property="article:section" content="{{ meta.section }}">
{% endif %}{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta.ogTitle or meta.title }}">
<meta name="twitter:description" content="{{ meta.description }}">
<meta name="twitter:image" content="{{ meta.image }}">
{% if meta.imageAlt %}<meta name="twitter:image:alt" content="{{ meta.imageAlt }}">
{% endif %}
{% if S.seo_keywords %}<meta name="keywords" content="{{ S.seo_keywords }}">{% endif %}
{% if S.google_verification %}<meta name="google-site-verification" content="{{ S.google_verification }}">{% endif %}
{% if S.bing_verification %}<meta name="msvalidate.01" content="{{ S.bing_verification }}">{% endif %}
{% if S.yandex_verification %}<meta name="yandex-verification" content="{{ S.yandex_verification }}">{% endif %}
{% if S.facebook_verification %}<meta name="facebook-domain-verification" content="{{ S.facebook_verification }}">{% endif %}
<meta name="theme-color" content="#215d41">
<meta name="format-detection" content="telephone=no">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
{# لا preload للخطوط: في Chromium يحجب أول رسم حتى تكتمل، وفي آخر <body> ينافس صورة البطل (LCP).
   القياس على الجوال: FCP ‎3.2s←1.0s و LCP ‎3.5s←2.8s. الخطوط تُكتشف من site.css مع font-display:swap #}
<link rel="stylesheet" href="{{ asset('/css/site.css') }}">
{# مؤقت أثناء إعادة تصميم الأقسام — تُدمج في site.css قبل النشر #}
{% for f in ['sx-heroes', 'sx-content', 'sx-cards', 'sx-convert'] %}<link rel="stylesheet" href="{{ asset('/css/' + f + '.css') }}">{% endfor %}
<link rel="stylesheet" href="{{ asset('/css/theme-dark.css') }}">
{% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}" {% if imgSet(preloadImage) %}imagesrcset="{{ imgSet(preloadImage) }}" imagesizes="100vw" {% endif %}fetchpriority="high">{% endif %}
{% if jsonld %}<script type="application/ld+json">{{ jsonld | json }}</script>{% endif %}
<script>window.ISGHA={{ clientCfg | json }};</script>
{% if not isPreview %}{% include "partials/tracking-head.njk" %}{% endif %}
{% if not isPreview and page and page.settings and page.settings.head_code %}{{ page.settings.head_code | safe }}{% endif %}
</head>
<body class="{{ bodyClass }}">
{% if not isPreview %}{% include "partials/tracking-body.njk" %}{% endif %}
{% if isPreview %}<div class="preview-flag" role="status">معاينة — المسودة غير منشورة</div>{% endif %}
<a class="skip" href="#main">تخطَّ إلى المحتوى</a>
{% if layout == 'landing' %}{% include "partials/header-landing.njk" %}{% else %}{% include "partials/header.njk" %}{% endif %}
<main id="main">
{% block main %}{% endblock %}
</main>
{% if layout == 'landing' %}{% include "partials/footer-landing.njk" %}{% else %}{% include "partials/footer.njk" %}{% endif %}
{% include "partials/floats.njk" %}
<script src="{{ asset('/js/site.js') }}" defer></script>
<script src="{{ asset('/js/theme.js') }}" defer></script>
{% for f in ['sx-heroes', 'sx-content', 'sx-cards', 'sx-convert'] %}<script src="{{ asset('/js/' + f + '.js') }}" defer></script>{% endfor %}
{% if not isPreview and page and page.settings and page.settings.body_code %}{{ page.settings.body_code | safe }}{% endif %}
{% if S.body_end_code and not isPreview %}{{ S.body_end_code | safe }}{% endif %}
</body>
</html>
