{% extends "admin/layout.njk" %}
{% import "admin/partials/charts.njk" as ch with context %}
{% block head %}<link rel="stylesheet" href="{{ asset('/css/admin-charts.css') }}">{% endblock %}
{% block actions %}
{% if can('analytics') %}<a class="btn btn-line btn-sm" href="/admin/analytics/report?d=30" target="_blank" rel="noopener" title="تقرير آخر ٣٠ يومًا جاهز للطباعة أو الحفظ PDF">{{ icon('download') }} تقرير PDF</a>{% endif %}
{% if can('landing') %}<a class="btn btn-teal btn-sm" href="/admin/pages?kind=landing">{{ icon('plus') }} صفحة هبوط</a>{% endif %}
{% endblock %}
{% block content %}
{% set L = data.leads %}{% set TR = data.traffic %}
<section class="hello">
  <div>
    <p class="muted">أهلًا {{ me.name }} 👋</p>
    <h2>{{ "طلبات اليوم: " + (L.today | ar) if L else "لوحة تحكم موقع إصغاء" }}</h2>
  </div>
  {% if L and L.waiting %}<a class="btn btn-ink" href="/admin/leads?status=new">{{ icon('inbox') }} {{ L.waiting | ar }} طلب جديد بانتظار التواصل</a>{% endif %}
</section>

{% if data.kpis.length %}
<div class="kpis">{% for k in data.kpis %}{{ ch.kpi(k) }}{% endfor %}</div>
{% endif %}

{% if L %}
<div class="grid-2-1">
  <section class="card ch-card">
    <header class="card-head">
      <div><h3>الطلبات يوميًا</h3><p class="ch-subtitle">{{ data.period }} مقارنةً بالـ٣٠ يومًا التي قبلها</p></div>
      {{ ch.legend([{ label: 'آخر ٣٠ يومًا', color: 'teal' }, { label: 'الفترة السابقة', color: 'prev', dashed: true }]) }}
    </header>
    {% if L.hasTrend %}
    <div class="ch-stats">
      <div><b>{{ nf(L.month) }}</b><small>طلب {{ ch.delta(L.delta) }}</small></div>
      <div><b>{{ L.avg }}</b><small>متوسط يومي</small></div>
      {% if L.best and L.best.n %}<div><b>{{ nf(L.best.n) }}</b><small>أعلى يوم ({{ L.best.day }})</small></div>{% endif %}
    </div>
    {{ ch.chart('ch-trend', L.trend, 'الطلبات اليومية خلال آخر ٣٠ يومًا مقارنةً بالفترة السابقة', 230, 'وصل ' + nf(L.month) + ' طلبًا خلال آخر ٣٠ يومًا مقابل ' + nf(L.prevMonth) + ' في الفترة السابقة.') }}
    {% else %}
    {{ ch.empty('لا توجد طلبات خلال آخر ٦٠ يومًا بعد. سيظهر هنا منحنى الطلبات اليومي ومقارنته بالفترة السابقة فور وصول الطلبات.', 'inbox') }}
    {% endif %}
  </section>

  <section class="card ch-card">
    <header class="card-head"><div><h3>مسار الطلبات</h3><p class="ch-subtitle">كل الطلبات حسب الحالة</p></div><a class="link" href="/admin/leads">كل الطلبات {{ icon('arrow-left') }}</a></header>
    {% if L.pipeline.total %}
    {{ ch.pipeline(L.pipeline) }}
    {% else %}
    {{ ch.empty('لا توجد طلبات بعد.', 'inbox') }}
    {% endif %}
    <div class="ch-facts">
      <a href="/admin/leads?status=new"><small>بانتظار التواصل</small><b>{{ nf(L.waiting) }}</b><em>{{ ('أقدمها ' + (L.oldestNew | rel | ar)) if L.oldestNew else 'لا شيء متأخر' }}</em></a>
      <div title="الوسيط: نصف الطلبات يُتواصل معها خلال هذا الوقت أو أقل (آخر ٣٠ يومًا)"><small>زمن الرد المعتاد</small><b>{{ L.resp.text if L.resp else '—' }}</b><em>{{ (nf(L.resp.within1h) + '٪ خلال ساعة') if L.resp else 'لا توجد بيانات بعد' }}</em></div>
    </div>
  </section>
</div>
{% endif %}

{% if TR or data.funnel %}
<div class="ch-grid">
  {% if TR %}
  <section class="card ch-card">
    <header class="card-head">
      <div><h3>الزيارات والطلبات</h3><p class="ch-subtitle">هل تتحول زيارات الموقع إلى طلبات؟</p></div>
      <span class="ch-badge">معدل التحويل <b>{{ TR.convText }}</b></span>
    </header>
    {% if TR.hasCombo %}
    {{ ch.chart('ch-combo', TR.combo, 'الزوار والطلبات يوميًا خلال آخر ٣٠ يومًا', 380,nf(TR.visitors) + ' زائرًا و' + nf(L.month if L else 0) + ' طلبًا، بمعدل تحويل ' + TR.convText) }}
    {% else %}
    {{ ch.empty('ستظهر الزيارات والطلبات هنا بعد أول زيارات للموقع.', 'users') }}
    {% endif %}
  </section>
  {% endif %}
  {% if data.funnel %}
  <section class="card ch-card">
    <header class="card-head"><div><h3>قمع التحويل</h3><p class="ch-subtitle">أين نفقد العملاء المحتملين؟ — آخر ٣٠ يومًا</p></div></header>
    {{ ch.funnel(data.funnel) }}
  </section>
  {% elif TR %}
  <section class="card ch-card">
    <header class="card-head"><div><h3>قمع التحويل</h3><p class="ch-subtitle">أين نفقد العملاء المحتملين؟</p></div></header>
    {{ ch.empty('يظهر القمع بعد تسجيل أول زيارات للموقع.', 'filter') }}
  </section>
  {% endif %}
</div>
{% endif %}

{% if L %}
<div class="ch-grid">
  <section class="card ch-card">
    <header class="card-head"><div><h3>من أين تأتي الطلبات؟</h3><p class="ch-subtitle">حسب القناة — آخر ٣٠ يومًا</p></div></header>
    {% if L.channels.rows.length %}{{ ch.hbars(L.channels, { won: true }) }}{% else %}{{ ch.empty('لا توجد طلبات خلال آخر ٣٠ يومًا.', 'megaphone') }}{% endif %}
  </section>
  <section class="card ch-card">
    <header class="card-head"><div><h3>أنواع القضايا المطلوبة</h3><p class="ch-subtitle">حسب نوع القضية أو الخدمة — آخر ٣٠ يومًا</p></div></header>
    {% if L.cases.rows.length %}{{ ch.hbars(L.cases, { won: true }) }}{% else %}{{ ch.empty('لا توجد طلبات خلال آخر ٣٠ يومًا.', 'scale') }}{% endif %}
  </section>
</div>
{% endif %}

{% if TR or L %}
<div class="ch-grid">
  {% if TR %}
  <section class="card ch-card">
    <header class="card-head">
      <div><h3>نقرات الاتصال والواتساب</h3><p class="ch-subtitle">كيف يفضّل الزوار التواصل؟ — آخر ٣٠ يومًا</p></div>
      {{ ch.legend([{ label: 'واتساب', color: 'c1', value: nf(TR.wa) }, { label: 'اتصال هاتفي', color: 'c2', value: nf(TR.calls) }]) }}
    </header>
    {% if TR.hasContacts %}
    <p class="ch-note">{{ icon('whatsapp') }} <span><b>{{ nf(TR.waShare) }}٪</b> من نقرات التواصل كانت على واتساب</span></p>
    {{ ch.chart('ch-contacts', TR.contactsChart, 'نقرات الاتصال والواتساب يوميًا خلال آخر ٣٠ يومًا', 280,nf(TR.wa) + ' نقرة واتساب و' + nf(TR.calls) + ' نقرة اتصال.') }}
    {% else %}
    {{ ch.empty('لم تُسجَّل نقرات على أزرار الاتصال أو الواتساب بعد.', 'phone') }}
    {% endif %}
  </section>
  {% endif %}
  {% if L %}
  <section class="card ch-card">
    <header class="card-head"><div><h3>أوقات وصول الطلبات</h3><p class="ch-subtitle">اليوم × الساعة بتوقيت الرياض — آخر ٩٠ يومًا</p></div></header>
    {% if L.heat.total %}{{ ch.heat(L.heat) }}{% else %}{{ ch.empty('ستظهر أوقات الذروة بعد وصول بعض الطلبات.', 'clock') }}{% endif %}
  </section>
  {% endif %}
</div>
{% endif %}

<div class="grid-2-1">
  {% if L %}
  <section class="card">
    <header class="card-head"><h3>أحدث الطلبات</h3><a class="link" href="/admin/leads">كل الطلبات {{ icon('arrow-left') }}</a></header>
    {% if L.recent.length %}
    <div class="table-wrap"><table class="tbl cards" style="--actw:0px">
      <thead><tr><th>العميل</th><th>النوع</th><th>المصدر</th><th>الحالة</th><th>الوقت</th></tr></thead>
      <tbody>
      {% for l in L.recent %}
      <tr data-href="/admin/leads/{{ l.id }}">
        <td class="c-main"><a href="/admin/leads/{{ l.id }}"><b>{{ l.name }}</b></a><small class="ltr muted">{{ l.phone | pretty_phone }}</small></td>
        <td data-label="النوع"><span>{{ l.case_type or '—' }}</span></td>
        <td data-label="المصدر"><span class="src">{{ l.source }}</span></td>
        <td data-label="الحالة"><span class="pill {{ l.st.color }}">{{ l.st.label }}</span></td>
        <td class="muted nowrap" data-label="الوقت"><span>{{ l.created_at | rel | ar }}</span></td>
      </tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% else %}
    <div class="empty">{{ icon('inbox') }}<p>لا توجد طلبات بعد. ستظهر هنا فور وصول أول طلب من الموقع.</p></div>
    {% endif %}
  </section>
  {% endif %}
  <section class="card">
    <header class="card-head"><h3>جاهزية الموقع</h3>{% set doneN = data.checklist | count_by('done') %}<span class="pill teal">{{ doneN | ar }} / {{ data.checklist.length | ar }}</span></header>
    <ul class="checklist">
      {% for c in data.checklist %}<li class="{{ 'done' if c.done }}"><a href="{{ c.url }}">{{ icon('check-circle' if c.done else 'circle-dot') }}<span>{{ c.label }}</span></a></li>{% endfor %}
    </ul>
  </section>
</div>

<section class="quick">
  {% if can('pages') %}<a class="quick-item" href="/admin/pages">{{ icon('layout-template') }}<b>تعديل صفحات الموقع</b><span>الرئيسية، من نحن، الخدمات…</span></a>{% endif %}
  {% if can('media') %}<a class="quick-item" href="/admin/media/slots">{{ icon('image') }}<b>صور الموقع</b><span>ارفع الصور مع برومبت كل صورة</span></a>{% endif %}
  {% if can('posts') %}<a class="quick-item" href="/admin/r/posts/new">{{ icon('newspaper') }}<b>مقال جديد</b><span>محتوى يرفع ظهورك في جوجل</span></a>{% endif %}
  {% if can('marketing') %}<a class="quick-item" href="/admin/marketing">{{ icon('megaphone') }}<b>ربط الإعلانات</b><span>جوجل، ميتا، سناب، تيك توك</span></a>{% endif %}
</section>
{% endblock %}

{% block scripts %}
{% if data.leads or data.traffic %}<script src="/vendor/chart.umd.min.js"></script>{% endif %}
<script src="{{ asset('/js/admin-charts.js') }}"></script>
{% endblock %}
