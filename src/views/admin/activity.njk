{% extends "admin/layout.njk" %}
{% set crumbs = [{label: 'النظام', url: '/admin/system'}, {label: 'سجل النشاط'}] %}
{% block content %}
<form class="filters card" method="get">
  <label class="fld"><span>المستخدم</span><select name="user" onchange="this.form.submit()"><option value="">الكل</option>{% for u in users %}<option value="{{ u.id }}" {{ 'selected' if q.user == u.id | string }}>{{ u.name }}</option>{% endfor %}</select></label>
  <label class="fld"><span>الإجراء</span><select name="action" onchange="this.form.submit()"><option value="">الكل</option>{% for k, l in labels %}<option value="{{ k }}" {{ 'selected' if q.action == k }}>{{ l }}</option>{% endfor %}</select></label>
</form>
<div class="card flush">
  <div class="table-wrap"><table class="tbl cards" style="--actw:0px">
    <thead><tr><th>التفاصيل</th><th>الوقت</th><th>المستخدم</th><th>الإجراء</th><th>القسم</th><th>IP</th></tr></thead>
    <tbody>
    {% for r in rows %}
    <tr><td class="c-main">{{ r.summary or (labels[r.action] or r.action) }}</td><td class="nowrap muted" data-label="الوقت"><span title="{{ r.created_at | date(true) | ar }}">{{ r.created_at | rel | ar }}</span></td><td data-label="المستخدم"><span>{{ r.user_name or 'النظام' }}</span></td><td data-label="الإجراء"><span class="pill sm">{{ labels[r.action] or r.action }}</span></td><td class="ltr muted" data-label="القسم"><span>{{ r.entity }}{{ ' #' + r.entity_id if r.entity_id and r.entity_id.length < 12 }}</span></td><td class="ltr muted small" data-label="IP"><span>{{ r.ip }}</span></td></tr>
    {% else %}
    <tr><td colspan="6" class="muted center">لا يوجد نشاط مسجّل.</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</div>
{% include "admin/partials/pager.njk" %}
{% endblock %}
