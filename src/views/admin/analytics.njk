{% extends "admin/layout.njk" %}
{% import "admin/partials/charts.njk" as ch with context %}
{% block head %}<link rel="stylesheet" href="{{ asset('/css/admin-charts.css') }}">{% endblock %}
{% block actions %}
<nav class="seg" aria-label="الفترة">
  {% for o in [[7, '٧ أيام'], [30, '٣٠ يومًا'], [90, '٩٠ يومًا'], [365, 'سنة']] %}<a href="?d={{ o[0] }}" class="{{ 'on' if range == o[0] }}"{% if range == o[0] %} aria-current="page"{% endif %}>{{ o[1] }}</a>{% endfor %}
</nav>
<a class="btn btn-line btn-sm" href="/admin/analytics/report?d={{ range }}" target="_blank" rel="noopener" title="تقرير {{ rangeLabel }} جاهز للطباعة أو الحفظ PDF">{{ icon('download') }} تصدير PDF</a>
{% endblock %}
{% block content %}
<p class="ch-period">{{ icon('calendar') }}<span><b>{{ rangeLabel }}</b> · {{ period }}</span><span class="muted">مقارنةً بـ {{ prevPeriod }}</span></p>

<div class="kpis six">
  {{ ch.kpi({ icon: 'users', label: 'الزوار', value: nf(totals.uniques), delta: deltas.uniques, sub: nf(totals.views) + ' مشاهدة', spark: sparks.uniques, sparkColor: 'gold' }) }}
  {{ ch.kpi({ icon: 'inbox', tone: 'teal', label: 'الطلبات', value: nf(totals.leads), delta: deltas.leads, sub: nf(totals.won) + ' تم التعاقد', spark: sparks.leads, sparkColor: 'teal' }) }}
  {{ ch.kpi({ icon: 'percent', tone: 'yellow', label: 'معدل التحويل', value: totals.convText, delta: deltas.conv, sub: 'طلبات ÷ زوار' }) }}
  {{ ch.kpi({ icon: 'phone', label: 'نقرات الاتصال', value: nf(totals.calls), delta: deltas.calls, spark: sparks.calls, sparkColor: 'c2' }) }}
  {{ ch.kpi({ icon: 'whatsapp', label: 'نقرات واتساب', value: nf(totals.whatsapp), delta: deltas.whatsapp, spark: sparks.whatsapp, sparkColor: 'c1' }) }}
  {{ ch.kpi({ icon: 'clipboard', label: 'بدأوا تعبئة النموذج', value: nf(totals.formStarts), delta: deltas.formStarts, spark: sparks.formStarts, sparkColor: 'teal' }) }}
</div>

<section class="card ch-card">
  <header class="card-head">
    <div><h3>الزوار والطلبات {{ 'أسبوعيًا' if range > 90 else 'يوميًا' }}</h3><p class="ch-subtitle">لوحتان متزامنتان على محور زمني واحد — مرّر المؤشر لرؤية اليوم ومعدل تحويله</p></div>
    <span class="ch-badge">معدل التحويل <b>{{ totals.convText }}</b></span>
  </header>
  {% if hasCombo %}
  {{ ch.chart('ch-combo', combo, 'الزوار والطلبات خلال ' + rangeLabel, 320, nf(totals.uniques) + ' زائرًا و' + nf(totals.leads) + ' طلبًا خلال ' + rangeLabel + '، بمعدل تحويل ' + totals.convText) }}
  {% else %}
  {{ ch.empty('لا توجد زيارات أو طلبات مسجّلة في هذه الفترة.', 'chart-line') }}
  {% endif %}
</section>

<div class="ch-grid">
  <section class="card ch-card">
    <header class="card-head">
      <div><h3>مصادر الزيارات عبر الزمن</h3><p class="ch-subtitle">من أين يأتي الزوار، وهل يتغير ذلك؟ (عدد الزوار)</p></div>
    </header>
    {% if sourcesChart %}
    {{ ch.legend(sourcesLegend) }}
    {{ ch.chart('ch-sources', sourcesChart, 'مصادر الزيارات عبر الزمن', 250, 'أكبر مصدر للزيارات: ' + sources[0].label + ' (' + nf(sources[0].u) + ' زائرًا).') }}
    {% else %}
    {{ ch.empty('لا توجد بيانات في هذه الفترة.', 'globe') }}
    {% endif %}
  </section>
  <section class="card ch-card">
    <header class="card-head"><div><h3>الأجهزة</h3><p class="ch-subtitle">على أي جهاز يتصفح الزوار الموقع؟</p></div></header>
    {% if devTotal %}
    {{ ch.donut('ch-devices', devicesChart, devices, 'توزيع الزوار حسب الجهاز') }}
    {% else %}
    {{ ch.empty('لا توجد بيانات في هذه الفترة.', 'smartphone') }}
    {% endif %}
  </section>
</div>

<div class="ch-grid">
  <section class="card ch-card">
    <header class="card-head"><div><h3>قمع التحويل</h3><p class="ch-subtitle">أين نفقد العملاء المحتملين؟ — {{ rangeLabel }}</p></div></header>
    {% if funnel %}{{ ch.funnel(funnel) }}{% else %}{{ ch.empty('يظهر القمع بعد تسجيل زيارات في هذه الفترة.', 'filter') }}{% endif %}
  </section>
  <section class="card ch-card">
    <header class="card-head"><div><h3>مصادر الطلبات</h3><p class="ch-subtitle">أي القنوات تجلب طلبات وعملاء متعاقدين؟</p></div></header>
    {% if leadSources.rows.length %}{{ ch.hbars(leadSources, { won: true }) }}{% else %}{{ ch.empty('لا توجد طلبات في هذه الفترة.', 'megaphone') }}{% endif %}
  </section>
</div>

<div class="ch-grid">
  <section class="card ch-card">
    <header class="card-head"><div><h3>أكثر الصفحات زيارة</h3><p class="ch-subtitle">عدد المشاهدات — أعلى ١٠ صفحات</p></div></header>
    {% if topPages.length %}{{ ch.hbars({ rows: topPages }, { metric: 'المشاهدات', ltr: true }) }}{% else %}{{ ch.empty('لا توجد زيارات مسجّلة في هذه الفترة.', 'layout-template') }}{% endif %}
  </section>
  <section class="card ch-card">
    <header class="card-head"><div><h3>كل مصادر الزيارات</h3><p class="ch-subtitle">عدد الزوار حسب المصدر</p></div></header>
    {% if sourceBars.rows.length %}{{ ch.hbars(sourceBars, { metric: 'الزوار' }) }}{% else %}{{ ch.empty('لا توجد بيانات في هذه الفترة.', 'globe') }}{% endif %}
  </section>
</div>

{% if landing.length %}
<section class="card flush ch-card">
  <header class="card-head pad"><div><h3>أداء صفحات الهبوط</h3><p class="ch-subtitle">الزوار يوميًا، الطلبات، ونسبة التحويل لكل صفحة</p></div></header>
  <div class="table-wrap"><table class="tbl ch-lp">
    <thead><tr><th>الصفحة</th><th>الزوار</th><th class="hide-sm">الاتجاه</th><th>الطلبات</th><th>التحويل</th><th></th></tr></thead>
    <tbody>{% for p in landing %}<tr>
      <td><a class="strong" href="/admin/pages/{{ p.id }}">{{ p.title }}</a><small class="ltr muted">/{{ p.slug }}</small></td>
      <td class="nowrap">{{ nf(p.uniques) }}<small class="muted">{{ nf(p.views) }} مشاهدة</small></td>
      <td class="hide-sm">{% if p.uniques %}<svg class="ch-spark sm" data-spark="{{ p.spark | join(',') }}" data-color="gold" role="img" aria-label="اتجاه الزوار لصفحة {{ p.title }}"></svg>{% else %}<span class="muted">—</span>{% endif %}</td>
      <td><a href="/admin/leads?page_id={{ p.id }}">{{ nf(p.leads) }}</a></td>
      <td class="nowrap"><b>{{ p.conv }}</b><span class="ch-meter" aria-hidden="true"><i style="width:{{ p.crW | round(1) }}%"></i></span></td>
      <td>{% if p.status != 'published' %}<span class="pill gray">مسودة</span>{% endif %}</td>
    </tr>{% endfor %}</tbody>
  </table></div>
</section>
{% endif %}

{% if campaigns.length %}
<section class="card flush">
  <header class="card-head pad"><h3>الحملات الإعلانية (UTM)</h3></header>
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>الحملة</th><th>المصدر</th><th>الطلبات</th><th>تم التعاقد</th></tr></thead>
    <tbody>{% for c in campaigns %}<tr><td class="ltr"><a href="/admin/leads?campaign={{ c.campaign | urlencode }}">{{ c.campaign }}</a></td><td class="ltr muted">{{ c.source }}</td><td>{{ nf(c.leads) }}</td><td>{{ nf(c.won) }}</td></tr>{% endfor %}</tbody>
  </table></div>
</section>
{% endif %}

<section class="card flush">
  <header class="card-head pad"><h3>تفاصيل الصفحات</h3></header>
  {% if pages.length %}
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>الرابط</th><th>المشاهدات</th><th>الزوار</th><th>بدء النموذج</th><th>الطلبات</th><th>التحويل</th></tr></thead>
    <tbody>{% for p in pages %}<tr><td class="ltr"><a href="{{ p.path }}" target="_blank" rel="noopener">{{ p.path }}</a></td><td>{{ nf(p.v) }}</td><td>{{ nf(p.u) }}</td><td>{{ nf(p.starts) }}</td><td>{{ nf(p.leads) }}</td><td>{{ p.conv }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p class="muted pad">لا توجد زيارات مسجّلة في هذه الفترة.</p>{% endif %}
</section>

{% if notFound.length %}
<section class="card">
  <header class="card-head"><h3>روابط مفقودة (404)</h3><a class="link" href="/admin/r/redirects/new">إضافة تحويل {{ icon('arrow-left') }}</a></header>
  <ul class="mini-list">{% for n in notFound %}<li><span class="ltr">{{ n.path }}</span><small>{{ nf(n.n) }} مرة</small></li>{% endfor %}</ul>
</section>
{% endif %}
<p class="hint center">الإحصاءات من الموقع نفسه بدون كوكيز طرف ثالث (تستبعد الزواحف والروبوتات). للتحليل المتقدم اربط Google Analytics من «الإعلانات والتتبع».</p>
{% endblock %}
{% block scripts %}
<script src="/vendor/chart.umd.min.js"></script>
<script src="{{ asset('/js/admin-charts.js') }}"></script>
{% endblock %}
