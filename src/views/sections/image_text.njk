{% import "partials/macros.njk" as m %}
<section class="sec sxi {{ m.bgclass(d) }}" data-sx="image_text" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap sxi-grid {% if d.image_side == 'end' %}img-end{% endif %}">
    <figure class="sxi-fig rv">
      {{ m.pic(imgFor(d.image, d.image_slot), d.image_alt or d.title | plain, 'sxi-media') }}
      <figcaption class="sxi-badge {% if not d.badge %}mark-only{% endif %}">
        <span class="sxi-mk"><img src="/img/mark.svg" alt="" width="18" height="20"></span>
        {% if d.badge %}<span>{{ d.badge }}</span>{% endif %}
      </figcaption>
    </figure>
    <div class="sxi-txt rv" style="--i:1">
      {% if d.tag %}<span class="tag">{{ d.tag }}</span>{% endif %}
      {% if d.title %}<h2>{{ d.title | markup }}</h2>{% endif %}
      {% if d.intro %}<p class="sxi-intro">{{ d.intro }}</p>{% endif %}
      {% if d.body %}<div class="prose sxi-prose">{{ d.body | safe }}</div>{% endif %}
      {% if d.bullets | length %}<ul class="sxi-bul">{% for b in d.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
      {% if d.cta_label %}<a class="btn btn-teal sxi-cta" href="{{ d.cta_url }}">{{ d.cta_label }} {{ icon('arrow-left') }}</a>{% endif %}
    </div>
  </div>
</section>
