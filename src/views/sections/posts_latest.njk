{% import "partials/macros.njk" as m %}
{% if D.posts.length %}
{% set n = D.posts.length %}
<section class="sec sx-posts {{ m.bgclass(d) }}" data-sxc="posts" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    <div class="pst-top">
      {{ m.sechead(d, 'pst-head') }}
      {% if d.all_label %}<a class="pst-all rv" href="{{ d.all_url or '/insights' }}"><span>{{ d.all_label }}</span>{{ icon('arrow-left') }}</a>{% endif %}
    </div>
    <div class="pst-grid n{{ n if n < 4 else 'x' }}" data-sx-rail>
      {% for p in D.posts %}{% include "partials/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}
