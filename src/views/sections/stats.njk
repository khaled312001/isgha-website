{% import "partials/macros.njk" as m %}
{% if d.items.length %}
<section class="sec tight {{ m.bgclass(d) }}" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    {{ m.sechead(d, 'split') }}
    <div class="stats">
      {% for s in d.items %}<div class="stat rv d{{ loop.index0 % 4 }}"><b>{{ s.value }}</b><span>{{ s.label }}</span></div>{% endfor %}
    </div>
  </div>
</section>
{% endif %}
