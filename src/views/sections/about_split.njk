{% import "partials/macros.njk" as m %}
{% set aImg = imgFor(d.image, d.image_slot or 'home_about') %}
<section class="sec ab {{ m.bgclass(d) }}" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap ab-grid {% if d.image_side == 'end' %}img-end{% endif %}">
    <div class="ab-media rv">
      <span class="ab-block" aria-hidden="true"></span>
      <div class="ab-photo">{{ m.pic(aImg, d.image_alt or d.title | plain, '', false, '(max-width: 960px) 100vw, 500px') }}</div>
      {% if d.badge %}<span class="ab-badge"><span class="ab-badge-mk"><img src="/img/mark.svg" alt="" width="15" height="17"></span>{{ d.badge }}</span>{% endif %}
    </div>
    <div class="ab-copy rv d1">
      {% if d.tag %}<span class="tag">{{ d.tag }}</span>{% endif %}
      {% if d.title %}<h2>{{ d.title | markup }}</h2>{% endif %}
      {% if d.intro %}<p class="ab-intro">{{ d.intro }}</p>{% endif %}
      {% if d.body %}<div class="prose ab-prose">{{ d.body | safe }}</div>{% endif %}
      {% if d.cta_label %}<a class="btn btn-ink ab-btn" href="{{ d.cta_url }}"><span>{{ d.cta_label }}</span><span class="ab-bub">{{ icon('arrow-left') }}</span></a>{% endif %}
    </div>
  </div>
</section>
