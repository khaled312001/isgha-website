{% import "partials/macros.njk" as m %}
{% set kindIcons = { timeline: 'route', quote: 'receipt', updates: 'bell', chips: 'users' } %}
<section class="sec cx-show {{ m.bgclass(d) }}" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    {{ m.sechead(d) }}
    {% if d.cards | length %}
    <div class="cx-show-grid" data-cx-swipe>
      {% for c in d.cards %}
      {% set items = c.items | lines %}
      {% set kind = c.kind if c.kind in ['timeline', 'quote', 'updates'] else 'chips' %}
      <article class="cx-show-card rv" style="--i:{{ loop.index0 }}">
        <div class="cx-show-txt">
          <span class="cx-show-ic" aria-hidden="true">{{ icon(c.icon or kindIcons[kind]) }}</span>
          <div>
            <h3>{{ c.title }}</h3>
            {% if c.text %}<p>{{ c.text }}</p>{% endif %}
          </div>
        </div>
        <div class="cx-show-stage">
          <div class="cx-mui cx-mui-{{ kind }}">
            <div class="cx-mui-bar" aria-hidden="true"><img src="/img/mark.svg" alt="" width="12" height="14"><i></i><i></i><u></u></div>
            <div class="cx-mui-body">
            {% if kind == 'timeline' %}
              {% for it in items %}{% set L = it | lead %}
              <div class="cx-ts {% if loop.index < items.length - 1 %}is-done{% elif loop.index == items.length - 1 %}is-now{% endif %}" style="--k:{{ loop.index0 }}">
                <span class="cx-ts-dot">{% if loop.index < items.length - 1 %}{{ icon('check') }}{% endif %}</span>
                <div><b>{{ L.title or L.text }}</b>{% if L.title %}<span>{{ L.text }}</span>{% endif %}</div>
              </div>
              {% endfor %}
            {% elif kind == 'quote' %}
              {% for it in items %}{% set L = it | lead %}
              <div class="cx-qr {% if loop.last %}is-total{% endif %}" style="--k:{{ loop.index0 }}">
                <span>{{ L.title or L.text }}</span>
                {% if L.title %}<em>{% if not loop.last %}{{ icon('check') }}{% endif %}{{ L.text }}</em>{% endif %}
              </div>
              {% endfor %}
            {% elif kind == 'updates' %}
              {% set uics = ['file-text', 'calendar', 'phone', 'bell'] %}
              {% for it in items %}{% set L = it | lead %}
              <div class="cx-nf {% if loop.first %}is-new{% endif %}" style="--k:{{ loop.index0 }}">
                <span class="cx-nf-ic">{{ icon(uics[loop.index0 % 4]) }}</span>
                <div><b>{{ L.title or L.text }}</b>{% if L.title %}<span>{{ L.text }}</span>{% endif %}</div>
              </div>
              {% endfor %}
            {% else %}
              <div class="cx-chips">{% for it in items %}<span style="--k:{{ loop.index0 }}" {% if loop.index0 % 3 == 0 %}class="is-hl"{% endif %}>{{ it }}</span>{% endfor %}</div>
            {% endif %}
            </div>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="cx-swipe-dots" aria-hidden="true">{% for c in d.cards %}<i {% if loop.first %}class="on"{% endif %}></i>{% endfor %}</div>
    {% endif %}
  </div>
</section>
