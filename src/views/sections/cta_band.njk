{% set callHref = ((page.settings.phone if page and page.settings and page.settings.phone) or S.phone) | tel %}
<section class="sec tight cx-cta-sec" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    <div class="cta-band cx-cta rv">
      <span class="cx-cta-pat" aria-hidden="true"></span>
      <div class="cx-cta-txt">
        {% if d.tag %}<span class="tag">{{ d.tag }}</span>{% endif %}
        {% if d.title %}<h2>{{ d.title | markup }}</h2>{% endif %}
        {% if d.text %}<p>{{ d.text }}</p>{% endif %}
      </div>
      <div class="cta-actions cx-cta-actions">
        {% if d.primary_label %}<a class="cx-cta-btn is-main" href="{{ d.primary_url or '#form' }}"><span>{{ d.primary_label }}</span>{{ icon('arrow-left', 'cx-arr') }}</a>{% endif %}
        {% if d.show_call %}<a class="cx-cta-btn is-call" href="{{ callHref }}">{{ icon('phone') }}<span>{{ d.call_label or 'اتصل الآن' }}</span></a>{% endif %}
        {% if d.show_whatsapp %}<a class="cx-cta-btn is-wa" href="{{ S.whatsapp | wa(S.whatsapp_message) }}" target="_blank" rel="noopener">{{ icon('whatsapp') }}<span>{{ d.wa_label or 'واتساب' }}</span></a>{% endif %}
      </div>
    </div>
  </div>
</section>
