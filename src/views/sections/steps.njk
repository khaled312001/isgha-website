{% import "partials/macros.njk" as m %}
{% set n = d.items | length %}
<section class="sec cx-steps {{ m.bgclass(d) }}" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    {{ m.sechead(d) }}
    {% if n %}
    <div class="cx-tl" data-cx-tl style="--n:{{ n }}">
      <div class="cx-tl-rail" aria-hidden="true"><span class="cx-tl-fill"></span></div>
      <ol class="cx-tl-list">
        {% for it in d.items %}
        <li class="cx-tl-step rv" style="--i:{{ loop.index0 }}">
          <div class="cx-tl-node" aria-hidden="true"><span class="cx-tl-ic">{{ icon(it.icon or ['inbox', 'phone', 'file-check', 'square-check'][loop.index0 % 4]) }}</span></div>
          <div class="cx-tl-card">
            <span class="cx-tl-num" aria-hidden="true">{{ loop.index | ar }}</span>
            <h3>{{ it.title }}</h3>
            {% if it.text %}<p>{{ it.text }}</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}
  </div>
</section>
