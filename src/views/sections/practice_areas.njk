{% import "partials/macros.njk" as m %}
{% if D.areas.length %}
<section class="sec sxa {{ m.bgclass(d) }}" data-sx="practice_areas" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    {{ m.sechead(d) }}
    <ul class="sxa-grid {% if not d.show_desc %}plain{% endif %}">
      {% for a in D.areas %}
      <li class="sxa-tile rv" style="--i:{{ loop.index0 % 8 }}">
        <span class="sxa-wm" aria-hidden="true">{{ icon(a.icon or 'scale') }}</span>
        <span class="sxa-top">
          <span class="sxa-ic">{{ icon(a.icon or 'scale') }}</span>
          <span class="sxa-n" aria-hidden="true">{{ loop.index | pad2 }}</span>
        </span>
        <b class="sxa-t">{{ a.title }}</b>
        {% if d.show_desc and a.description %}<span class="sxa-d">{{ a.description }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
