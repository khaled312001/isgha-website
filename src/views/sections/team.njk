{% import "partials/macros.njk" as m %}
{% if D.team.length %}
<section class="sec sxm {{ m.bgclass(d) }}" data-sx="team" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    {{ m.sechead(d) }}
    <ul class="sxm-grid">
      {% for t in D.team %}
      <li class="sxm-card rv" style="--i:{{ loop.index0 % 8 }}">
        <figure class="sxm-fig">
          {{ m.pic(t.photo, t.name, 'sxm-media', false, '', 'alt') }}
          {% if t.bio %}<figcaption class="sxm-bio"><p>{{ t.bio }}</p></figcaption>{% endif %}
          {% if t.linkedin %}<a class="sxm-in" href="{{ t.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn: {{ t.name }}">{{ icon('linkedin') }}</a>{% endif %}
        </figure>
        <div class="sxm-txt">
          <b>{{ t.name }}</b>
          {% if t.title %}<span>{{ t.title }}</span>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
