{% import "partials/macros.njk" as m %}
{% set types = d.case_types if (d.case_types and d.case_types.length) else caseTypes %}
{% set lImg = imgFor(d.image, 'consultation_call') %}
<section class="sec cx-lform {{ m.bgclass(d) }}" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap cx-lf-grid">
    <div class="cx-lf-txt">
      <div class="rv">
        {% if d.tag %}<span class="tag">{{ d.tag }}</span>{% endif %}
        {% if d.title %}<h2 class="cx-lf-title">{{ d.title | markup }}</h2>{% endif %}
        {% if d.intro %}<p class="cx-lf-intro">{{ d.intro }}</p>{% endif %}
      </div>
      {% if d.points | length %}
      <ul class="cx-lf-points">
        {% for p in d.points %}<li class="rv" style="--i:{{ loop.index0 }}"><span class="cx-lf-ic" aria-hidden="true">{{ icon('check') }}</span><span>{{ p }}</span></li>{% endfor %}
      </ul>
      {% endif %}
      {% if lImg %}<div class="cx-lf-media rv d2">{{ m.pic(lImg, d.image_alt or 'استشارة قانونية', 'arch-soft', false, '(max-width: 960px) 90vw, 480px') }}</div>{% endif %}
    </div>
    <div class="cx-lf-form">{{ m.mform(d, S, types, ts) }}</div>
  </div>
</section>
