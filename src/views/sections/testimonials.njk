{% import "partials/macros.njk" as m %}
{% set list = d.items if d.source == 'items' else D.testimonials %}
{% if list.length %}
<section class="sec {{ m.bgclass(d) }}" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    {{ m.sechead(d) }}
    <div class="tgrid">
      {% for t in list %}
      <figure class="tcard rv d{{ loop.index0 % 3 }}">
        <div class="stars" aria-label="تقييم ٥ من ٥">★★★★★</div>
        <blockquote><p>{{ t.quote }}</p></blockquote>
        <figcaption class="who"><b>{{ t.name }}</b><span>{{ t.context }}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
