{% import "partials/macros.njk" as m %}
{% set heads = tocOf(d.body) if d.toc else [] %}
{% set hasToc = heads.length > 1 %}
<section class="sec sx-rtx {{ m.bgclass(d) }}" data-sxc="rich_text" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="{{ 'wrap' if (hasToc or d.width == 'wide') else 'wrap-narrow' }}">
    <div class="rtx{% if hasToc %} has-toc{% endif %}" data-rtx>
      {% if hasToc %}
      <nav class="rtx-side" aria-label="{{ d.toc_title }}">
        <details class="rtx-toc" open data-rtx-toc>
          <summary><span class="rtx-toc-ic">{{ icon('list-ordered') }}</span><b>{{ d.toc_title }}</b><span class="rtx-toc-n">{{ heads.length | ar }}</span>{{ icon('chevron-down', 'rtx-chev') }}</summary>
          <span class="rtx-prog" aria-hidden="true"><i></i></span>
          <ol>
            {% for h in heads %}<li><a href="#{{ h.id }}"><span class="n">{{ loop.index | pad2 }}</span><span>{{ h.text }}</span></a></li>{% endfor %}
          </ol>
        </details>
      </nav>
      {% endif %}
      <article class="rtx-paper rv">
        {% if d.title %}<h2 class="rtx-title">{{ d.title | markup }}</h2>{% endif %}
        <div class="prose">{{ (withHeadingIds(d.body) if d.toc else d.body) | safe }}</div>
      </article>
    </div>
  </div>
</section>
