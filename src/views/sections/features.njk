{% import "partials/macros.njk" as m %}
<section class="sec {{ m.bgclass(d) }}" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap">
    {{ m.sechead(d, 'split' if d.style == 'numbered' else '') }}
    {% if d.style == 'cards' %}
    <div class="feat-cards">
      {% for it in d.items %}
      <article class="fc rv d{{ loop.index0 % 3 }}"><span class="ic">{{ icon(it.icon or 'check-circle') }}</span><h3>{{ it.title }}</h3><p>{{ it.text }}</p></article>
      {% endfor %}
    </div>
    {% elif d.style == 'list' %}
    <div class="feat-list">
      {% for it in d.items %}
      <article class="f rv"><span class="ic">{{ icon(it.icon or 'check') }}</span><div><h3>{{ it.title }}</h3><p>{{ it.text }}</p></div></article>
      {% endfor %}
    </div>
    {% else %}
    <div class="feat-num">
      {% for it in d.items %}
      <article class="f rv d{{ loop.index0 % 4 }}">
        <div class="n">{{ loop.index | pad2 }} {{ icon(it.icon or 'check-circle') }}</div>
        <h3>{{ it.title }}</h3>
        <p>{{ it.text }}</p>
      </article>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
