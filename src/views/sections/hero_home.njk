{% import "partials/macros.njk" as m %}
{% set heroImg = imgFor(d.image, 'home_hero') %}
<section class="hero hx" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="hx-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid hx-grid">
    <div class="hero-copy hx-copy">
      {% if d.eyebrow %}<p class="eyebrow hx-eyebrow hx-in" style="--d:0">{{ d.eyebrow }}</p>{% endif %}
      <h1 class="hx-title hx-in" style="--d:1">{{ d.title | markup }}</h1>
      {% if d.lead %}<p class="lead hx-in" style="--d:2">{{ d.lead }}</p>{% endif %}
      <div class="hero-actions hx-actions hx-in" style="--d:3">
        {% if d.primary_label %}<a class="btn btn-teal btn-lg hx-btn hx-btn-main" href="{{ d.primary_url }}"><span>{{ d.primary_label }}</span><span class="hx-btn-bub">{{ icon('arrow-left') }}</span></a>{% endif %}
        {% if d.show_call %}<a class="btn btn-white btn-lg hx-btn hx-btn-call" href="{{ S.phone | tel }}"><span class="hx-btn-ic">{{ icon('phone') }}</span>اتصل الآن</a>{% endif %}
        {% if d.show_whatsapp %}<a class="btn btn-wa btn-lg hx-btn hx-btn-wa" href="{{ S.whatsapp | wa(S.whatsapp_message) }}" target="_blank" rel="noopener"><span class="hx-btn-ic">{{ icon('whatsapp') }}</span>واتساب</a>{% endif %}
      </div>
      {% if d.badges | length %}
      <ul class="trust hx-trust hx-in" style="--d:4">
        {% set ics = ['shield', 'lock', 'clock', 'check-circle'] %}
        {% for b in d.badges %}<li><span class="hx-trust-ic">{{ icon(ics[loop.index0 % 4]) }}</span><span>{{ b }}</span></li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    <div class="hero-media hx-media">
      <span class="hx-frame" aria-hidden="true"></span>
      <span class="hx-tri" aria-hidden="true"></span>
      <div class="hx-photo">{{ m.pic(heroImg, d.image_alt, 'arch', true) }}</div>
      <span class="hx-key" aria-hidden="true"><img src="/img/mark.svg" alt="" width="26" height="29"></span>
      {% if d.card_title %}
      <div class="float-card hx-card">
        <span class="mk"><img src="/img/mark.svg" alt="" width="20" height="23"></span>
        <div><b>{{ d.card_title }}</b>{% if d.card_text %}<span>{{ d.card_text }}</span>{% endif %}</div>
      </div>
      {% endif %}
    </div>
  </div>
  {% if d.show_quicklinks and D.categories | length %}
  <div class="wrap">
    <nav class="hx-tiles" aria-label="خدماتنا">
      {% set fallbackIcons = ['scale', 'file-text', 'stamp', 'layers'] %}
      {% for c in D.categories %}
      {% set cImg = imgFor(c.image, 'service_' + c.slug) %}
      <a class="hx-tile" href="{{ c.url }}" style="--i:{{ loop.index0 }}">
        {% if cImg %}<span class="hx-tile-img" data-img="{{ cImg }}" aria-hidden="true"></span>{% endif %}
        <span class="hx-tile-top">
          <span class="hx-tile-ic">{{ icon(c.icon or fallbackIcons[loop.index0 % 4]) }}</span>
          <span class="hx-tile-n" aria-hidden="true">{{ loop.index | pad2 }}</span>
        </span>
        <span class="hx-tile-body">
          <b class="hx-tile-t">{{ c.title }}</b>
          {% if c.tagline %}<span class="hx-tile-d">{{ c.tagline }}</span>{% endif %}
        </span>
        <span class="hx-tile-go" aria-hidden="true">{{ icon('arrow-left') }}</span>
      </a>
      {% endfor %}
    </nav>
  </div>
  {% endif %}
</section>
