{% import "partials/macros.njk" as m %}
{% set heroImg = imgFor(d.image, 'home_hero') %}
<section class="hero" {% if d.anchor %}id="{{ d.anchor }}"{% endif %}>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {% if d.eyebrow %}<p class="eyebrow">{{ d.eyebrow }}</p>{% endif %}
      <h1>{{ d.title | markup }}</h1>
      {% if d.lead %}<p class="lead">{{ d.lead }}</p>{% endif %}
      <div class="hero-actions">
        {% if d.primary_label %}<a class="btn btn-teal btn-lg" href="{{ d.primary_url }}">{{ d.primary_label }} {{ icon('arrow-left') }}</a>{% endif %}
        {% if d.show_call %}<a class="btn btn-white btn-lg" href="{{ S.phone | tel }}">{{ icon('phone') }} اتصل الآن</a>{% endif %}
        {% if d.show_whatsapp %}<a class="btn btn-wa btn-lg" href="{{ S.whatsapp | wa(S.whatsapp_message) }}" target="_blank" rel="noopener">{{ icon('whatsapp') }} واتساب</a>{% endif %}
      </div>
      {% if d.badges | length %}
      <ul class="trust">
        {% set ics = ['shield', 'lock', 'clock', 'check-circle'] %}
        {% for b in d.badges %}<li>{{ icon(ics[loop.index0 % 4]) }}{{ b }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    <div class="hero-media">
      {{ m.pic(heroImg, d.image_alt, 'arch', true) }}
      {% if d.card_title %}
      <div class="float-card">
        <span class="mk"><img src="/img/mark.svg" alt="" width="20" height="23"></span>
        <div><b>{{ d.card_title }}</b><span>{{ d.card_text }}</span></div>
      </div>
      {% endif %}
    </div>
  </div>
  {% if d.show_quicklinks and D.categories | length %}
  <div class="wrap">
    <nav class="hx-tiles" aria-label="خدماتنا">
      {% set fallbackIcons = ['scale', 'file-text', 'stamp', 'layers'] %}
      {% for c in D.categories %}
      {% set cImg = imgFor(c.image, 'service_' + c.slug) %}
      <a class="hx-tile" href="{{ c.url }}" style="--i:{{ loop.index0 }}">
        {% if cImg %}<span class="hx-tile-img" data-img="{{ cImg }}" aria-hidden="true"></span>{% endif %}
        <span class="hx-tile-top">
          <span class="hx-tile-ic">{{ icon(c.icon or fallbackIcons[loop.index0 % 4]) }}</span>
          <span class="hx-tile-n" aria-hidden="true">{{ loop.index | pad2 }}</span>
        </span>
        <span class="hx-tile-body">
          <b class="hx-tile-t">{{ c.title }}</b>
          {% if c.tagline %}<span class="hx-tile-d">{{ c.tagline }}</span>{% endif %}
        </span>
        <span class="hx-tile-go" aria-hidden="true">{{ icon('arrow-left') }}</span>
      </a>
      {% endfor %}
    </nav>
  </div>
  {% endif %}
</section>
