{% extends "layouts/site.njk" %}
{% block main %}
<section class="phero no-img">
  <img class="phero-deco" src="/img/mark-teal.svg" alt="" aria-hidden="true">
  <div class="wrap">
    <ol class="crumbs" aria-label="مسار التنقل">{% for c in crumbs %}<li>{% if not loop.last %}<a href="{{ c.url }}">{{ c.label }}</a>{% else %}<span aria-current="page">{{ c.label }}</span>{% endif %}</li>{% endfor %}</ol>
    <span class="tag">{{ hero.tag or 'المعرفة القانونية' }}</span>
    <h1>{{ (activeCat.name if activeCat else hero.title) | markup }}</h1>
    <p class="lead">{{ activeCat.description if activeCat and activeCat.description else hero.lead }}</p>
    <div class="phero-line"></div>
  </div>
</section>
<section class="sec" style="padding-top:20px">
  <div class="wrap">
    {% if cats.length %}
    <nav class="cat-bar" aria-label="تصنيفات المقالات">
      <a href="/insights" {% if not activeCat %}class="on"{% endif %}>الكل</a>
      {% for c in cats %}<a href="/insights/category/{{ c.slug }}" {% if activeCat and activeCat.id == c.id %}class="on"{% endif %}>{{ c.name }}</a>{% endfor %}
    </nav>
    {% endif %}
    {% if posts.length %}
    <div class="posts">{% for p in posts %}{% include "partials/post-card.njk" %}{% endfor %}</div>
    {% if pages > 1 %}
    <nav class="pager" aria-label="الصفحات">
      {% for n in range(1, pages + 1) %}{% if n == pageNum %}<span class="on" aria-current="page">{{ n | ar }}</span>{% else %}<a href="?page={{ n }}">{{ n | ar }}</a>{% endif %}{% endfor %}
    </nav>
    {% endif %}
    {% else %}
    <div class="empty-state"><img src="/img/mark-teal.svg" alt="">قريبًا: مقالات وإرشادات قانونية يكتبها فريق إصغاء.</div>
    {% endif %}
  </div>
</section>
{% for sec in tailSections %}{% set d = sec.data %}{% include "sections/" + sec.type + ".njk" ignore missing %}{% endfor %}
{% endblock %}
