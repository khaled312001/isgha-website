# ─── التشغيل ───
NODE_ENV=production
PORT=3000
# رابط الموقع (احتياطي — الرابط الأساسي الفعلي يُضبط من اللوحة: محركات البحث ← الدومين الأساسي)
SITE_URL=https://isgha.sa
# سلسلة عشوائية طويلة (48 حرفًا على الأقل) — مطلوبة في الإنتاج
SESSION_SECRET=
# اتركها false على الدومين التجريبي، وغيّرها إلى true بعد ربط الدومين النهائي
ALLOW_INDEXING=false
# تحويل تلقائي لـ HTTPS وللدومين الأساسي (بعد ربط الدومين)
FORCE_HTTPS=false
# مثال: isgha.sa (مع أو بدون https://) — يحوّل www وأي دومين آخر إليه
CANONICAL_HOST=
TRUST_PROXY=1
AUTO_MIGRATE=true

# ─── قاعدة البيانات (MySQL) — على Hostinger استخدم 127.0.0.1 ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=5

# ─── الملفات المرفوعة والنسخ الاحتياطية (خارج مجلد التطبيق حتى لا تُحذف عند التحديث) ───
UPLOADS_DIR=../storage/uploads
BACKUPS_DIR=../storage/backups

# ─── حساب المالك (يُنشأ تلقائيًا عند أول تشغيل إذا كانت القاعدة فارغة) — احذفها بعد أول دخول ───
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ─── البريد (اختياري — يمكن ضبطه من لوحة التحكم بدلًا من هنا) ───
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
